# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# ── Database ───────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/voicechat
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/voicechat
MONGO_URI=mongodb://127.0.0.1:27017/voicechat

# ── Redis (presence, rate-limit, socket adapter) ───────
# Leave empty to run with an in-memory fallback (dev only)
REDIS_URL=redis://127.0.0.1:6379

# ── Auth ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Agora RTC (voice) ──────────────────────────────────
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_TOKEN_TTL_SECONDS=3600

# ── Payments ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYMOB_API_KEY=xxx
PAYMOB_INTEGRATION_ID=xxx

# ── Google OAuth (verify id_token) ─────────────────────
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# ── Translation (Google Cloud Translation) ─────────────
GOOGLE_TRANSLATE_API_KEY=xxx

# ── Push (Firebase Cloud Messaging) ────────────────────
FCM_SERVER_KEY=xxx

# ── OTP (SMS provider — Twilio / Vonage / local) ───────
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=xxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM=+10000000000

# ── Admin bootstrap ────────────────────────────────────
ADMIN_EMAIL=admin@voicechat.app
ADMIN_PASSWORD=Admin@12345
