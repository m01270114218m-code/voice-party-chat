// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  avatar    String?
  bio       String?
  status    String   @default("online") // online, away, offline
  coins     Int      @default(0)
  xp        Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownedRooms    Room[]        @relation("ownedRooms")
  roomMembers   RoomMember[]  @relation("userMembers")
  sentMessages  RoomMessage[]
  followers     Follow[]      @relation("followers")
  following     Follow[]      @relation("following")
  gifts         Gift[]
  achievements  Achievement[] @relation("userAchievements")
}

model Room {
  id          String   @id @default(cuid())
  name        String
  description String?
  topic       String?
  category    String   @default("general") // gaming, music, study, etc
  ownerid     String
  capacity    Int      @default(12)
  isPrivate   Boolean  @default(false)
  isLocked    Boolean  @default(false)
  password    String?
  avatar      String?
  cover       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner         User         @relation("ownedRooms", fields: [ownerid], references: [id], onDelete: Cascade)
  members       RoomMember[]
  messages      RoomMessage[]
  recordings    Recording[]
  achievements  Achievement[] @relation("roomAchievements")

  @@index([ownerid])
  @@index([isPrivate])
}

model RoomMember {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  role      String   @default("member") // owner, moderator, speaker, listener
  muted     Boolean  @default(false)
  deafened  Boolean  @default(false)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  // Relations
  user User  @relation("userMembers", fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([roomId])
}

model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String
  emoji     String?
  createdAt DateTime @default(now())

  // Relations
  room User @relation(fields: [userId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([createdAt])
}

model Recording {
  id        String   @id @default(cuid())
  roomId    String
  title     String?
  url       String
  duration  Int      // in seconds
  size      Int      // in bytes
  createdAt DateTime @default(now())

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model Follow {
  id        String   @id @default(cuid())
  followerId String
  followingId String
  createdAt DateTime @default(now())

  // Relations
  follower  User @relation("followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Gift {
  id        String   @id @default(cuid())
  userId    String
  icon      String
  name      String
  cost      Int
  createdAt DateTime @default(now())

  // Relations
  sender User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Achievement {
  id        String   @id @default(cuid())
  userId    String?
  roomId    String?
  title     String
  icon      String
  createdAt DateTime @default(now())

  // Relations
  user User? @relation("userAchievements", fields: [userId], references: [id], onDelete: Cascade)
  room Room? @relation("roomAchievements", fields: [roomId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roomId])
}
